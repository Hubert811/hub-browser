{
  "name": "@hub/browser",
  "version": "0.2.3",
  "type": "module",
  "bin": {
    "hub": "bin/hub.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./page": "./dist/page.js",
    "./factory": "./dist/factory.js"
  },
  "workspaces": [
    "vendor/browseros/packages/browseros-agent/packages/*",
    "src/browser-mcp"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "bun scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "BROWSEROS_CDP_PORT=9110 bun run tests/test-phase2a.ts",
    "test:session-adapter": "bun tests/session-mode-harness.ts",
    "test:unit": "bun test --timeout=30000 $(find tests src/space src/browser-mcp/src -name '*.test.ts' -not -path '*/node_modules/*' | tr '\\n' ' ')",
    "prepack": "bun run build",
    "release": "bun scripts/build-dist.mjs && node scripts/pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mozilla/readability": "^0.6.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^6.27.0",
    "ws": "^8.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0",
    "@types/bun": "^1.3.14"
  },
  "main": "dist/opencli-engine/main.js",
  "hubBrowserRoot": true,
  "files": [
    "bin/",
    "dist/",
    "clis/",
    "cli-manifest.json",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "(AGPL-3.0-or-later AND Apache-2.0)"
}
