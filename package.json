{
  "name": "@hub/browser",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "hub": "bin/hub.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.ts",
    "./factory": "./src/factory.ts"
  },
  "workspaces": [
    "vendor/browseros/packages/browseros-agent/packages/*"
