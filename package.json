{
  "name": "@hub/browser",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "hub": "bin/hub.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.ts",
    "./factory": "./src/factory.ts"
  },
  "workspaces": [
    "vendor/browseros/packages/browseros-agent/packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-patches.mjs",
    "build": "tsc --outDir dist --declaration false",
    "typecheck": "tsc --noEmit",
    "test": "BROWSEROS_CDP_PORT=9110 bun run tests/test-phase2a.ts"
  },
  "dependencies": {
    "@browseros/browser-core": "workspace:*",
    "@browseros/cdp-protocol": "workspace:*",
    "@browseros/shared": "workspace:*",
    "@jackwener/opencli": "latest",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.0"
  }
}
